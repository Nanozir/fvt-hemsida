---
import { steps, staff, quality, dataProtection } from '../data/site';
---
<section id="uppdragsgivare" class="clients" aria-labelledby="uppdrag-rubrik">
  <div class="wrap">
    <h2 id="uppdrag-rubrik">För Kriminalvården, kommuner och andra uppdragsgivare</h2>
    <p class="section-intro">Samhällsstart 90 är ett komplement till befintliga insatser. Urval, remissväg, ansvar och rapportering bestäms tillsammans innan start.</p>

    <div class="two-col">
      <div>
        <h3>Från första samtal till pilot</h3>
        <ol class="timeline">
          {steps.map(([title, text]) => <li><strong>{title}</strong><span>{text}</span></li>)}
        </ol>
      </div>
      <div class="stack">
        <div>
          <h3>Föreslagen bemanning</h3>
          <ul class="kv">{staff.map(([k, v]) => <li><span>{k}</span><span class="v">{v}</span></li>)}</ul>
          <p class="note">Bemanningen förutsätter finansiering och rekrytering. Pris lämnas på förfrågan.</p>
        </div>
        <div>
          <h3>Kvalitet och dataskydd</h3>
          <ul class="plain">{[...quality, ...dataProtection].map((t) => <li>{t}</li>)}</ul>
        </div>
      </div>
    </div>
  </div>
</section>
