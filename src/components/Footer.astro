---
import Ph from './Ph.astro';
import { site } from '../data/site';
---
<footer class="foot">
  <div class="wrap">
    <p>{site.name} · Org.nr <Ph text={site.orgNr} /> · <Ph text={site.address} />, {site.city}</p>
    <p>Samhällsstart 90 är ett frivilligt komplement till ordinarie stöd. Upplägg och villkor bestäms i en separat överenskommelse.</p>
    <p>Sidan använder inga kakor och ingen spårning.</p>
  </div>
</footer>
