---
import BrandMark from './BrandMark.astro';
import { site } from '../data/site';
const links = [
  ['#programmet', 'Programmet'],
  ['#uppdragsgivare', 'För uppdragsgivare'],
  ['#deltagare', 'För deltagare'],
  ['#om', 'Om föreningen'],
];
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="#start" aria-label={`${site.name}, till början`}>
      <BrandMark />
      <span class="brand-name">Värmland Tillsammans<small>Ideell förening · {site.city}</small></span>
    </a>
    <nav class="nav" aria-label="Huvudmeny">
      <ul>
        {links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
        <li><a class="cta" href="#kontakt">Kontakt</a></li>
      </ul>
    </nav>
  </div>
</header>
