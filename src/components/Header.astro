---
import BrandMark from './BrandMark.astro';
const links = [
  ['#faserna', 'Faserna'],
  ['#stodet', 'Så fungerar stödet'],
  ['#uppdragsgivare', 'För uppdragsgivare'],
  ['#deltagare', 'För deltagare'],
  ['#om', 'Om föreningen'],
  ['#kontakt', 'Kontakt'],
];
---
<header class="top">
  <div class="wrap top-inner">
    <a class="brand" href="#">
      <BrandMark />
      Värmland Tillsammans
    </a>
    <nav aria-label="Huvudmeny">
      {links.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>
  </div>
</header>
