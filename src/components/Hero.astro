---
import { facts } from '../data/site';
---
<section class="hero" id="start">
  <div class="wrap">
    <div>
      <p class="eyebrow">Föreningen Värmland Tillsammans</p>
      <h1>Samhällsstart <span>90</span></h1>
      <p class="lead">Praktiskt stöd under 90 dagar för en tryggare övergång till vardagslivet efter frigivning.</p>
      <div class="hero-actions">
        <a class="btn btn-sand" href="#uppdragsgivare">För uppdragsgivare</a>
        <a class="btn btn-ghost" href="#deltagare">För deltagare och anhöriga</a>
      </div>
    </div>
    <ul class="facts" aria-label="Programmet i siffror">
      {facts.map((f) => <li><span class="k">{f.k}</span><span class="v">{f.v}</span></li>)}
    </ul>
  </div>
  <svg class="treeline" viewBox="0 0 1200 38" preserveAspectRatio="none" aria-hidden="true">
    <path fill="currentColor" d="M0 38V30l20-14 14 10 18-20 16 18 12-8 22 16 18-22 20 24 14-10 16 12 22-26 18 22 12-6 20 14 16-18 18 16 14-8 22 18 18-24 20 20 12-6 18 12 22-22 16 18 14-8 20 16 18-20 16 14 12-4 22 14 18-24 20 22 14-10 16 12 22-26 18 22 12-6 20 14 16-18 18 16 14-8 22 18 18-24 20 20 12-6 18 12 22-22 16 18 14-8 20 16 18-20 16 14 12-4 22 14 18-24 20 22 14-10 16 12 22-26 18 22 12-6 20 14 16-18 18 16 14-8 22 18 18-24 20 20 12-6 18 12 22-22 16 18 14-8 20 16 18-20 16 14V38Z" />
  </svg>
</section>
