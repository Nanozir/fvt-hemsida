---
import { phases, weeks } from '../data/site';

// Granar i två lager, ritade en gång vid bygget (samma resultat varje gång).
let seed = 11;
const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const GROUND = 150;
const trees = (step: number, min: number, spread: number, offset: number) => {
  const out: string[] = [];
  for (let x = offset; x < 1200 + step; x += step) {
    const h = min + rand() * spread;
    const w = h * 0.42;
    const cx = x + (rand() - 0.5) * step * 0.5;
    out.push(`M${(cx - w / 2).toFixed(1)} ${GROUND}L${cx.toFixed(1)} ${(GROUND - h).toFixed(1)}L${(cx + w / 2).toFixed(1)} ${GROUND}Z`);
  }
  return out.join('');
};
const back = trees(22, 50, 60, 4);
const front = trees(34, 30, 45, 15);
// 12 veckor längs stigen, 100 enheter per vecka.
const weekX = weeks.map((_, i) => i * 100 + 50);
const pathY = (x: number) => 162 + Math.sin(x / 95) * 4;
const trailD = Array.from({ length: 61 }, (_, i) => {
  const x = i * 20;
  return `${i === 0 ? 'M' : 'L'}${x} ${pathY(x).toFixed(1)}`;
}).join('');
---
<section id="faserna" class="phases" aria-labelledby="faser-rubrik">
  <div class="wrap">
    <h2 id="faser-rubrik">Tre faser på 90 dagar</h2>
    <p class="section-intro">Stigen har tolv veckor och tre delar. Välj en fas för att se vad deltagaren arbetar med.</p>
  </div>

  <div class="trail-wrap">
    <div class="trail">
      <svg class="trail-art" viewBox="0 0 1200 230" preserveAspectRatio="none" aria-hidden="true">
        <path class="tree-back" d={back} />
        <path class="tree-front" d={front} />
        {phases.map((_, i) => (
          <rect class:list={['ground', { active: i === 0 }]} data-phase={i} x={i * 400} y={GROUND} width="400" height="80" />
        ))}
        <line class="edge" x1="0" y1={GROUND} x2="1200" y2={GROUND} />
        <line class="edge" x1="400" y1={GROUND} x2="400" y2="230" />
        <line class="edge" x1="800" y1={GROUND} x2="800" y2="230" />
        <path class="path-line" d={trailD} />
        {weekX.map((x, i) => (
          <circle class:list={['wk', { active: i < 4 }]} data-week={i} cx={x} cy={pathY(x)} r="7" />
        ))}
      </svg>
      <div class="trail-tabs" role="tablist" aria-label="Programmets faser">
        {phases.map((p, i) => (
          <button
            type="button"
            class="trail-btn"
            id={`fas-${i + 1}`}
            role="tab"
            aria-controls={`fas-panel-${i + 1}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-index={i}
          >
            <span class="num">{p.days}</span>
            <span class="lbl">{p.short}</span>
          </button>
        ))}
      </div>
    </div>
  </div>

  <div class="wrap">
    {phases.map((p, i) => (
      <div class="phase-panel" id={`fas-panel-${i + 1}`} role="tabpanel" aria-labelledby={`fas-${i + 1}`} tabindex="0" hidden={i !== 0}>
        <div>
          <p class="kicker">Fas {i + 1} av 3 · {p.days}</p>
          <h3>{p.title}</h3>
          <p class="question">{p.question}</p>
          <p>{p.goal}</p>
          <h4>När fasen är klar</h4>
          <p class="done">{p.done}</p>
        </div>
        <div>
          <h4>Det här gör vi</h4>
          <ul>{p.items.map((x) => <li>{x}</li>)}</ul>
          <h4>Veckans teman i arbetsboken</h4>
          <ul class="weeklist">
            {p.weeks.map((w) => (
              <li><span class="n">Vecka {w + 1}</span><span><b>{weeks[w][0]}.</b> {weeks[w][1]}</span></li>
            ))}
          </ul>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.trail-btn'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.phase-panel'));
  const grounds = Array.from(document.querySelectorAll<SVGRectElement>('.ground'));
  const wks = Array.from(document.querySelectorAll<SVGCircleElement>('.wk'));

  function select(i: number) {
    tabs.forEach((t, j) => {
      t.setAttribute('aria-selected', String(j === i));
      t.tabIndex = j === i ? 0 : -1;
    });
    panels.forEach((p, j) => (p.hidden = j !== i));
    grounds.forEach((g, j) => {
      g.classList.toggle('active', j === i);
      g.classList.toggle('passed', j < i);
    });
    wks.forEach((w, j) => {
      const phase = Math.floor(j / 4);
      w.classList.toggle('active', phase === i);
      w.classList.toggle('passed', phase < i);
    });
  }

  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(i));
    t.addEventListener('keydown', (e) => {
      let n: number | null = null;
      if (e.key === 'ArrowRight') n = (i + 1) % tabs.length;
      if (e.key === 'ArrowLeft') n = (i - 1 + tabs.length) % tabs.length;
      if (e.key === 'Home') n = 0;
      if (e.key === 'End') n = tabs.length - 1;
      if (n !== null) {
        e.preventDefault();
        select(n);
        tabs[n].focus();
      }
    });
  });
</script>
