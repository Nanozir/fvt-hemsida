---
import CheckList from './CheckList.astro';
import { phases, supportExamples, cannotPromise, weeks } from '../data/site';
---
<section class="band" id="programmet" aria-labelledby="h-programmet">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Programmet</p>
      <h2 id="h-programmet">Tre faser på 90 dagar</h2>
      <p class="lead">Deltagaren bestämmer sina egna mål. Vi hjälper till med det praktiska: vardagen, boendet, ekonomin, kontakter med myndigheter och vägen till jobb eller studier.</p>
    </div>

    <div class="timeline">
      <div class="track" aria-hidden="true">
        {phases.map((p) => <div class={p.cls}>{p.short}</div>)}
      </div>
      <div class="ticks" aria-hidden="true"><span>Dag 1</span><span>Dag 31</span><span><span>Dag 61</span><span>Dag 90</span></span></div>
      <div class="phases">
        {phases.map((p) => (
          <div class="phase">
            <p class="days">{p.days}</p>
            <h3>{p.title}</h3>
            <ul>{p.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>

    <div class="split">
      <div class="panel">
        <h3>Exempel på stöd</h3>
        <CheckList items={supportExamples} />
      </div>
      <div class="note">
        <h3>Det här kan vi inte lova</h3>
        <ul>{cannotPromise.map((t) => <li>{t}</li>)}</ul>
      </div>
    </div>

    <div class="mt-3">
      <h3>Ett tema varje vecka</h3>
      <p class="hint hint-gap">Deltagaren får en arbetsbok med en övning per vecka.</p>
      <ol class="weeks">
        {weeks.map(([title, text], i) => (
          <li class="week"><span class="n">Vecka {i + 1}</span><span><b>{title}</b><span>{text}</span></span></li>
        ))}
      </ol>
    </div>
  </div>
</section>
