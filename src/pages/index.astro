---
import Base from '../layouts/Base.astro';
import DraftBanner from '../components/DraftBanner.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Program from '../components/Program.astro';
import Buyers from '../components/Buyers.astro';
import Participants from '../components/Participants.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
---
<Base
  title="Samhällsstart 90 | Föreningen Värmland Tillsammans"
  description="Praktiskt stöd under 90 dagar för en tryggare övergång till vardagslivet efter frigivning. En ideell förening i Karlstad."
>
  {site.draft && <DraftBanner />}
  <Header />
  <main>
    <Hero />
    <Program />
    <Buyers />
    <Participants />
    <About />
    <Contact />
  </main>
  <Footer />
</Base>
